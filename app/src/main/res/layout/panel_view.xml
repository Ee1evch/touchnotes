<?xml version="1.0" encoding="utf-8"?>
<!--
  Плавающая карточка наставника «как у Google»: белая, скруглённая, с радужным свечением.
  Окно по высоте подстраивается под содержимое и растёт вверх от нижнего края экрана.
-->
<app.nastavnik.overlay.TouchAwareFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ручка: смахни вниз, чтобы свернуть в кнопку -->
        <FrameLayout
            android:id="@+id/handle_area"
            android:layout_width="match_parent"
            android:layout_height="18dp">

            <View
                android:id="@+id/handle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/handle_bg" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Наставник"
                    android:textColor="@color/text_main"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/subject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/chip_bg"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/text_muted"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_region"
                style="@style/Panel.Icon"
                android:contentDescription="Выделять область"
                android:src="@drawable/ic_crop" />

            <ImageButton
                android:id="@+id/btn_new"
                style="@style/Panel.Icon"
                android:contentDescription="Новая задача"
                android:src="@drawable/ic_add" />

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/Panel.Icon"
                android:contentDescription="Меню"
                android:src="@drawable/ic_more" />

            <ImageButton
                android:id="@+id/btn_collapse"
                style="@style/Panel.Icon"
                android:contentDescription="Свернуть"
                android:src="@drawable/ic_expand_more" />
        </LinearLayout>

        <!-- Переписка или чистовик; высота задаётся из кода по содержимому -->
        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/chat_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/clean_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/clean_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />

                <HorizontalScrollView
                    android:id="@+id/clean_thumbs_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/clean_thumbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/clean_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/clean_preview_host"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/clean_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/c_add"
                            style="@style/Panel.Action"
                            android:text="+ Добавить экран" />

                        <Button
                            android:id="@+id/c_remove"
                            style="@style/Panel.Action"
                            android:text="Убрать последний" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/c_primary"
                            style="@style/Panel.Action.Primary"
                            android:text="Собрать чистовик" />

                        <Button
                            android:id="@+id/c_secondary"
                            style="@style/Panel.Action"
                            android:text="Пересобрать" />

                        <Button
                            android:id="@+id/c_cancel"
                            style="@style/Panel.Action"
                            android:text="Отмена" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Плашка «решение готово» -->
        <LinearLayout
            android:id="@+id/done_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/banner_done_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Решение готово. Сделать чистовик?"
                android:textColor="@color/done_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/done_clean"
                style="@style/Panel.Action.Primary"
                android:layout_marginTop="0dp"
                android:text="Сделать" />

            <ImageButton
                android:id="@+id/done_close"
                style="@style/Panel.Icon"
                android:contentDescription="Закрыть"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Строка ошибок и подсказок -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/banner_error_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/error_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/status_action"
                style="@style/Panel.Action"
                android:layout_marginTop="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/status_close"
                style="@style/Panel.Icon"
                android:contentDescription="Закрыть"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Быстрые подсказки — пилюли с цветными значками Google -->
        <LinearLayout
            android:id="@+id/quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/q_next"
                    style="@style/Panel.Quick"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_bulb"
                    android:drawableTint="@color/google_blue"
                    android:text="Подскажи следующий шаг" />

                <Button
                    android:id="@+id/q_error"
                    style="@style/Panel.Quick"
                    android:drawableStart="@drawable/ic_search"
                    android:drawableTint="@color/google_red"
                    android:text="Проверь, где ошибка" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/q_theory"
                    style="@style/Panel.Quick"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_book"
                    android:drawableTint="@color/google_yellow"
                    android:text="Объясни теорию" />

                <Button
                    android:id="@+id/q_clean"
                    style="@style/Panel.Quick"
                    android:drawableStart="@drawable/ic_note"
                    android:drawableTint="@color/google_green"
                    android:text="Сделать чистовик" />
            </LinearLayout>
        </LinearLayout>

        <!-- Строка ввода: пилюля «Спросить наставника» и круглая радужная кнопка -->
        <LinearLayout
            android:id="@+id/input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/btn_shot"
                    style="@style/Panel.Icon"
                    android:contentDescription="Прикладывать снимок экрана"
                    android:src="@drawable/ic_camera" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Спросить наставника"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:paddingStart="6dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btn_mic"
                    style="@style/Panel.Icon"
                    android:contentDescription="Сказать голосом"
                    android:src="@drawable/ic_mic" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/send_btn_bg"
                android:contentDescription="Отправить"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</app.nastavnik.overlay.TouchAwareFrame>
