<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/panel_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Шапка: за неё можно смахнуть панель к краю -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/handle"
                android:layout_width="5dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/handle_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Наставник"
                    android:textColor="@color/text_main"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_bg"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/text_muted"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_region"
                style="@style/Panel.Icon"
                android:contentDescription="Выделять область"
                android:src="@drawable/ic_crop" />

            <ImageButton
                android:id="@+id/btn_new"
                style="@style/Panel.Icon"
                android:contentDescription="Новая задача"
                android:src="@drawable/ic_add" />

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/Panel.Icon"
                android:contentDescription="Меню"
                android:src="@drawable/ic_more" />

            <ImageButton
                android:id="@+id/btn_collapse"
                style="@style/Panel.Icon"
                android:contentDescription="Свернуть"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Быстрые кнопки -->
        <LinearLayout
            android:id="@+id/quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/q_next"
                    style="@style/Panel.Quick"
                    android:layout_marginEnd="6dp"
                    android:text="Подскажи следующий шаг" />

                <Button
                    android:id="@+id/q_error"
                    style="@style/Panel.Quick"
                    android:text="Проверь, где ошибка" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/q_theory"
                    style="@style/Panel.Quick"
                    android:layout_marginEnd="6dp"
                    android:text="Объясни теорию" />

                <Button
                    android:id="@+id/q_clean"
                    style="@style/Panel.Quick"
                    android:text="Сделать чистовик" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/chat_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Режим чистовика -->
            <LinearLayout
                android:id="@+id/clean_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/clean_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/clean_thumbs_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/clean_thumbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/clean_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_muted"
                    android:textIsSelectable="false"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/clean_preview_host"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1" />

                <!-- Кнопки чистовика; видимость управляется из кода -->
                <LinearLayout
                    android:id="@+id/clean_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/c_add"
                            style="@style/Panel.Action"
                            android:text="+ Добавить экран" />

                        <Button
                            android:id="@+id/c_remove"
                            style="@style/Panel.Action"
                            android:text="Убрать последний" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/c_primary"
                            style="@style/Panel.Action.Primary"
                            android:text="Собрать чистовик" />

                        <Button
                            android:id="@+id/c_secondary"
                            style="@style/Panel.Action"
                            android:text="Пересобрать" />

                        <Button
                            android:id="@+id/c_cancel"
                            style="@style/Panel.Action"
                            android:text="Отмена" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Плашка «решение готово» -->
        <LinearLayout
            android:id="@+id/done_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/banner_done_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Решение готово. Сделать чистовик?"
                android:textColor="@color/done_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/done_clean"
                style="@style/Panel.Action.Primary"
                android:layout_marginTop="0dp"
                android:text="Сделать" />

            <ImageButton
                android:id="@+id/done_close"
                style="@style/Panel.Icon"
                android:contentDescription="Закрыть"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Строка ошибок и подсказок -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/banner_error_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/error_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/status_action"
                style="@style/Panel.Action"
                android:layout_marginTop="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/status_close"
                style="@style/Panel.Icon"
                android:contentDescription="Закрыть"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Ввод -->
        <LinearLayout
            android:id="@+id/input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_shot"
                style="@style/Panel.Icon"
                android:contentDescription="Прикладывать снимок экрана"
                android:src="@drawable/ic_camera" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="Спросить своими словами…"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="40dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_mic"
                style="@style/Panel.Icon"
                android:contentDescription="Сказать голосом"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/btn_send"
                style="@style/Panel.Icon"
                android:contentDescription="Отправить"
                android:src="@drawable/ic_send"
                android:tint="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
