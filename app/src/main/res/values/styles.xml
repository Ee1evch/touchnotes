<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- База для стилей Panel.* (имя с точкой неявно наследует родителя) -->
    <style name="Panel" />

    <!-- Быстрая подсказка: пилюля со значком, как подсказки Gemini -->
    <style name="Panel.Quick">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/quick_btn_bg</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Panel.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@drawable/quick_btn_bg</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Panel.Action.Primary">
        <item name="android:background">@drawable/primary_btn_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Panel.Icon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/round_btn_bg</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_muted</item>
    </style>
</resources>
