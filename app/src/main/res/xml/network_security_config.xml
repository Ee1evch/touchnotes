<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Запрет незашифрованного HTTP-трафика по умолчанию и доверие только системным CA -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Разрешение локального трафика для домашних прокси (только loopback и приватные подсети) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.in-addr.arpa</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>

    <!-- Пользовательские сертификаты (например, для отладочных proxy вроде Charles/Mitmproxy) разрешены строго в debug-сборках -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
