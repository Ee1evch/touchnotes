<?xml version="1.0" encoding="utf-8"?>
<!-- Второстепенная кнопка на стекле: прозрачная пилюля со светлой кромкой -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1A16161A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8CFFFFFF" />
            <stroke android:width="1dp" android:color="#2416161A" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
