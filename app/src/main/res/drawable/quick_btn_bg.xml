<?xml version="1.0" encoding="utf-8"?>
<!-- Пилюля в стиле подсказок Gemini -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#220B57D0">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#F5F7FA" />
                    <stroke android:width="1dp" android:color="#E3E3E3" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_container" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
